+        case ASTAL_CAVA_INPUT_OSS:
+            return INPUT_OSS;
+        case ASTAL_CAVA_INPUT_JACK:
+            return INPUT_JACK;
+        case ASTAL_CAVA_INPUT_SHMEM:
+            return INPUT_SHMEM;
+        case ASTAL_CAVA_INPUT_WINSCAP:
+            return INPUT_WINSCAP;
+        default:
+            return INPUT_PIPEWIRE;
+    }
+}
